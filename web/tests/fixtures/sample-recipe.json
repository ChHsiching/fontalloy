{
  "base": "fonts/MapleMono-NF-CN/MapleMonoNerdFont-CN-Regular.ttf",
  "donors": [
    "fonts/LXGWWenKai/LXGWWenKai-Regular.ttf",
    "fonts/SourceHanSans/SourceHanSansSC-Regular.ttc#1"
  ],
  "rules": [
    { "set": "ja", "fonts": ["donor-0"] },
    { "range": "0x2100-0x214F", "fonts": ["base", "donor-1"] },
    { "codepoint": 20013, "fonts": ["donor-1"] }
  ],
  "output": { "format": "ttf", "family": "My-Merged-Font" }
}
