{
  "base": "fonts/MapleMono-NF-CN/MapleMonoNerdFont-CN-Regular.ttf",
  "donors": ["fonts/LXGWWenKai/LXGWWenKai-Regular.ttf"],
  "rules": [{ "set": "zh_cn", "fonts": ["donor-0"] }],
  "normalization": {
    "mode": "optical",
    "optical_ratio": 1.3,
    "quote_dash_width": "fullwidth"
  },
  "weights": [
    { "weight": 400 },
    { "weight": 700, "style": "italic", "donors": { "donor-0": 700 } }
  ],
  "output": { "format": "ttc", "family": "Extended-Font" }
}
